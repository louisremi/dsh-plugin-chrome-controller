{
  "name": "dsh-plugin-chrome-controller",
  "version": "0.1.71",
  "private": true,
  "description": "Use a paired Chrome extension as DeepSeek Harness browser tools",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "extension",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT"
}
